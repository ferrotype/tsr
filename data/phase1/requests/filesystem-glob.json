      "case": "filesystem/glob/string-round-trip",
      "dialect": "lsp",
      "discriminates": "The round trip is faithful for every accepted pattern EXCEPT a negated range: [!a-z] renders \"[a-z]\", because charRange.String (glob.go:210-212) never reads the negate field the parser stored. A port that renders the '!' diverges here on the one case that matters. Three more: a//b and a///b must render with every separator, catching a port that collapses a run at parse time (which also flips the match rows in filesystem/glob/match-star-separator); {a,}, {,a}, {,} and {} must keep their empty alternatives, catching a port that prunes them as a tidy-up; and the lone \\xff must survive, catching a port that stores a literal as String and repairs it to U+FFFD.",
      "operation": "tsc/internal/glob/glob.go:Glob.String",
      "order_sensitive": true,
      "subject": "glob.Glob",
      "hosts": [
        "any"
      ],
      "host_note": "any"
