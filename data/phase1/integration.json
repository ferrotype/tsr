        "--case",
        "config/module/paths/substitution-and-ts-extension-suppression"
      ],
      "owner": "F5b",
      "additional_tests": [
        {
          "path": "crates/tsr_module/tests/relative_paths.rs",
          "test": "paths_keep_source_order_on_equal_prefixes_but_exact_matches_win",
          "command": [
            "cargo",
            "test",
            "-p",
            "tsr_module",
            "--test",
            "relative_paths",
            "paths_keep_source_order_on_equal_prefixes_but_exact_matches_win",
            "--",
            "--exact"
          ]
        }
      ]
    },
    {
      "id": "retained-program-snapshot",
      "claim": "An edited filesystem snapshot reloads changed text while retained bound files keep old text and symbols.",
      "kind": "test",
      "references": [
        "crates/tsr_compiler/src/tests.rs"
      ],
      "command": [
        "cargo",
        "test",
        "-p",
        "tsr_compiler",
        "--lib",
        "tests::retained_snapshot_edit_reuses_only_equal_parse_inputs",
        "--",
        "--exact"
      ],
      "owner": "F5b",
      "test": "retained_snapshot_edit_reuses_only_equal_parse_inputs",
      "boundary": "The witness replaces an immutable MemorySnapshot; it does not prove polling a live OS filesystem or watch scheduling."
    },
    {
      "id": "live-cached-filesystem",
      "claim": "Live mutations distinguish uncached reads from cached misses and deletions.",
      "kind": "cases",
      "references": [
        "filesystem/cachedvfs/readfile-is-never-cached",
        "filesystem/cachedvfs/cached-miss-then-creation",
        "filesystem/cachedvfs/cached-hit-then-deletion"
      ],
      "command": [
        "python3",
        "scripts/phase1.py",
        "capture",
        "--family",
        "filesystem",
        "--output",
        "target/phase1-f5-live",
        "--case",
        "filesystem/cachedvfs/readfile-is-never-cached",
        "--case",
        "filesystem/cachedvfs/cached-miss-then-creation",
        "--case",
        "filesystem/cachedvfs/cached-hit-then-deletion"
      ],
      "owner": "F5b",
      "boundary": "Composed with retained-program-snapshot for the Phase 1 contracts; no watch-mode connection or live filesystem freezing is claimed."
    },
    {
      "id": "installed-generated-assets",
