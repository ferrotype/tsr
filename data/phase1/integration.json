      "command": [
        "python3",
        "scripts/phase1.py",
        "capture",
        "--family",
        "config",
        "--output",
        "target/phase1-f5-order",
        "--case",
        "config/module/exports/condition-order-and-nesting",
        "--case",
        "config/module/exports/non-matching-conditions-are-announced-in-key-order"
      ],
      "owner": "F5b"
    },
    {
      "id": "ordered-config-resolution",
