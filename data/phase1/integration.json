        "tools/phase1/config/commandline_probe_test.go",
        "tools/phase1/config/renderer_test.go",
        "scripts/phase1_localized.py"
      ],
      "command": [
        "python3",
        "scripts/phase1_integration.py",
        "observe-localized-config"
      ],
      "owner": "F5b"
    },
    {
      "id": "ordered-package-resolution",
