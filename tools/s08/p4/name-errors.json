    {
      "id": "missing-dom",
      "files": {
        "/case.ts": "console; document; type Query=number;"
      },
      "roots": [
        "/case.ts"
      ],
      "queries": [
        {
          "id": "query",
          "file": "/case.ts",
          "declaration": "Query",
          "target": "name",
          "operation": "declared_type"
        }
      ]
    },
