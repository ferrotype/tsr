{
  "version": 1,
  "scope": "P4 CommonJS declaration export, require-import and function-expando transforms; declaration diagnostics run separately from semantic checking",
  "options": {
    "target": "ESNext",
    "module": "CommonJS",
    "strict": true,
    "noLib": false,
    "skipLibCheck": true,
    "declaration": true,
    "allowJs": true,
    "checkJs": true
  },
  "programs": [
    {
      "id": "exports-primitives",
      "files": {
        "/case.js": "exports.x=1; exports[\"space key\"]=\"a\"; exports.default=true;\n",
        "/probe.ts": "type Probe=number;\n"
      },
      "roots": [
        "/case.js",
        "/probe.ts"
      ],
      "queries": [
        {
          "id": "probe",
          "file": "/probe.ts",
          "declaration": "Probe",
          "target": "name",
          "operation": "declared_type_summary"
        }
      ]
    },
    {
      "id": "exports-alias",
      "files": {
        "/case.js": "const x=1; exports.x=x; exports.renamed=x;\n",
        "/probe.ts": "type Probe=number;\n"
