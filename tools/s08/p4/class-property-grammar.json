      "id": "asserted-property",
      "files": {
        "/main.ts": "class C{x!:number;}type T=C;"
      },
      "roots": [
        "/main.ts"
      ],
      "queries": [
        {
          "id": "T",
          "file": "/main.ts",
          "declaration": "T",
          "target": "name",
          "operation": "declared_type"
        }
      ]
    },
    {
