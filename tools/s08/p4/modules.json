{
  "version": 1,
  "scope": "S08 P4 namespace and internal alias source semantics",
  "options": {
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "noLib": true
  },
  "programs": [
    {
      "id": "namespace-values",
      "files": {
        "/case.ts": "namespace N { export const value = 1; export function f(x:string) { return x; } }\ntype Query = typeof N.value;"
      },
      "roots": [
        "/case.ts"
      ],
      "queries": [
        {
          "id": "query",
          "file": "/case.ts",
          "declaration": "Query",
          "target": "name",
          "operation": "declared_type"
        }
      ]
    },
    {
      "id": "nested-namespace",
      "files": {
        "/case.ts": "namespace N.Inner { export type T = { value:number }; export const value=1; }\ntype Query = N.Inner.T;"
      },
      "roots": [
        "/case.ts"
      ],
      "queries": [
        {
          "id": "query",
          "file": "/case.ts",
          "declaration": "Query",
          "target": "name",
          "operation": "declared_type"
        }
      ]
    },
    {
      "id": "namespace-alias",
      "files": {
        "/case.ts": "namespace N { export type T = { value:number }; export const value=1; }\nimport A = N;\ntype Query = A.T;"
      },
      "roots": [
        "/case.ts"
      ],
      "queries": [
        {
          "id": "query",
          "file": "/case.ts",
          "declaration": "Query",
          "target": "name",
          "operation": "declared_type"
        }
      ]
    },
    {
