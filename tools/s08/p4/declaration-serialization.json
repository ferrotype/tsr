{
  "version": 1,
  "scope": "S08 P4 declaration pseudo-type reuse, lexical scope and inference fallback; focused protocol, not E2 acceptance",
  "options": {
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "noLib": false,
    "skipLibCheck": true,
    "declaration": true,
    "isolatedDeclarations": true
  },
  "programs": [
    {
      "id": "call-fallback",
      "files": {
        "/main.ts": "declare function external(): number; export const value = external();\ntype Probe = number;\n"
      },
      "roots": [
        "/main.ts"
      ],
      "queries": [
        {
          "id": "probe",
          "file": "/main.ts",
          "declaration": "Probe",
          "target": "name",
          "operation": "declared_type"
        }
      ]
    },
    {
      "id": "nested-call-fallback",
      "files": {
        "/main.ts": "declare function external(): number; export const value = { nested: { value: external() } };\ntype Probe = number;\n"
      },
      "roots": [
        "/main.ts"
      ],
      "queries": [
        {
          "id": "probe",
          "file": "/main.ts",
          "declaration": "Probe",
          "target": "name",
          "operation": "declared_type"
        }
      ]
    },
    {
