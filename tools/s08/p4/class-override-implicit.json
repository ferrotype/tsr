{
  "version": 1,
  "scope": "S08 P4 noImplicitOverride class and parameter-property diagnostics",
  "options": {
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "noLib": true,
    "noImplicitOverride": true
