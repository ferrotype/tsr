      },
      "roots": [
        "/implicit-method.ts"
      ],
      "queries": [
        {
          "id": "query",
          "file": "/implicit-method.ts",
          "declaration": "Query",
          "target": "name",
          "operation": "declared_type"
        }
      ]
    },
    {
