{
  "version": 1,
  "scope": "S08 P4 constructor super-call presence, null heritage and nested scope checks",
  "options": {
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "noLib": true
  },
  "programs": [
    {
      "id": "missing-super",
      "files": {
        "/main.ts": "class B{}class C extends B{constructor(){}}type T=C;"
      },
      "roots": [
        "/main.ts"
      ],
      "queries": [
        {
          "id": "T",
          "file": "/main.ts",
          "declaration": "T",
          "target": "name",
          "operation": "declared_type"
        }
      ]
    },
    {
      "id": "direct-super",
      "files": {
        "/main.ts": "class B{}class C extends B{constructor(){super();}}type T=C;"
      },
      "roots": [
        "/main.ts"
      ],
      "queries": [
        {
          "id": "T",
          "file": "/main.ts",
          "declaration": "T",
          "target": "name",
          "operation": "declared_type"
        }
      ]
    },
    {
      "id": "conditional-super",
      "files": {
        "/main.ts": "class B{}class C extends B{x=1;constructor(b:boolean){if(b)super();else super();}}type T=C;"
      },
      "roots": [
        "/main.ts"
      ],
      "queries": [
        {
          "id": "T",
          "file": "/main.ts",
          "declaration": "T",
          "target": "name",
          "operation": "declared_type"
        }
      ]
    },
    {
      "id": "nested-super",
      "files": {
        "/main.ts": "class B{}class C extends B{constructor(){const f=()=>super();}}type T=C;"
      },
      "roots": [
        "/main.ts"
      ],
      "queries": [
        {
          "id": "T",
          "file": "/main.ts",
          "declaration": "T",
          "target": "name",
          "operation": "declared_type"
        }
      ]
    },
    {
      "id": "extends-null-super",
      "files": {
        "/main.ts": "class C extends null{constructor(){super();}}type T=C;"
      },
      "roots": [
        "/main.ts"
      ],
      "queries": [
        {
          "id": "T",
          "file": "/main.ts",
          "declaration": "T",
          "target": "name",
          "operation": "declared_type"
        }
      ]
    },
    {
      "id": "extends-null-empty",
      "files": {
        "/main.ts": "class C extends null{constructor(){}}type T=C;"
      },
      "roots": [
        "/main.ts"
      ],
      "queries": [
        {
          "id": "T",
          "file": "/main.ts",
          "declaration": "T",
          "target": "name",
          "operation": "declared_type"
        }
      ]
    },
    {
      "id": "super-argument-this",
      "files": {
        "/main.ts": "class B{constructor(n:number){}}class C extends B{x=1;constructor(){super(this.x);}}type T=C;"
      },
      "roots": [
        "/main.ts"
      ],
      "queries": [
        {
          "id": "T",
          "file": "/main.ts",
          "declaration": "T",
          "target": "name",
          "operation": "declared_type"
        }
      ]
    },
    {
      "id": "this-before-super",
      "files": {
        "/main.ts": "class B{}class C extends B{x=1;constructor(){this.x=2;super();}}type T=C;"
      },
      "roots": [
        "/main.ts"
      ],
      "queries": [
        {
          "id": "T",
          "file": "/main.ts",
          "declaration": "T",
          "target": "name",
          "operation": "declared_type"
        }
      ]
    }
  ],
  "merge": {
    "id": "shared-interface-checker-local-merges",
    "files": {
      "/base.ts": "interface Shared { base: string }\n",
      "/a.ts": "interface Shared { a: number }\n",
      "/b.ts": "interface Shared { b: boolean }\n"
    },
    "shared": "/base.ts",
    "symbol": "Shared",
    "modes": [
      "single-checker",
      "repeated",
      "separate-checker",
      "concurrent"
    ],
    "single_roots": [
      "/base.ts",
      "/a.ts",
      "/b.ts"
    ],
    "independent_roots": {
      "A": [
        "/base.ts",
        "/a.ts"
      ],
      "B": [
        "/base.ts",
        "/b.ts"
      ]
    }
  }
}
