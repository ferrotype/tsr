{
  "version": 1,
  "scope": "S08 P4 element-directed relation diagnostics and private/protected properties; not full P4 acceptance",
  "options": {
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "noLib": false,
    "skipLibCheck": true
