        "/globals.d.ts": "interface Array<T>{length:number;[n:number]:T;}interface ReadonlyArray<T>{length:number;readonly[n:number]:T;}interface IArguments{length:number;[n:number]:any;}interface String{length:number;}",
        "/jsdoc.js": "/** @param {string} tail */ export function f(){return arguments[0];}",
        "/main.ts": "import {f} from \"./jsdoc.js\";type A=typeof f; const x=f(1);"
      },
      "roots": [
        "/globals.d.ts",
        "/main.ts"
      ],
      "queries": [
        {
          "id": "A",
          "operation": "declared_type",
          "file": "/main.ts",
          "declaration": "A",
          "target": "name"
        }
      ]
    },
