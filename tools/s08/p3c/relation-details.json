{
  "version": 1,
  "scope": "P3 tuple, variance and predicate relation diagnostic elaboration",
  "options": {
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "noLib": false,
    "skipLibCheck": true
  },
  "programs": [
    {
      "id": "tuple-short",
      "files": {
        "/tuple-short.ts": "type A = [string]; type B = [string, number]; declare let source: A; let result: B = source;\n"
      },
      "roots": [
        "/tuple-short.ts"
      ],
      "queries": [
        {
          "id": "A",
          "file": "/tuple-short.ts",
          "declaration": "A",
          "target": "name",
          "operation": "declared_type_summary"
        }
      ]
    },
