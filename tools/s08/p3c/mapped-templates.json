  "programs": [
    {
      "id": "templates",
      "files": {
        "/case.ts": "type T = `x${\"a\" | \"b\"}${1 | 2}`; type Pattern = `id-${number}`; type Generic<S extends string> = `pre${S}`; type Inst = Generic<\"one\" | \"two\">; type Combined = { a: `x${string}` } & { a: number };\n"
      },
      "roots": [
        "/case.ts"
      ],
      "queries": [
        {
          "id": "T",
          "file": "/case.ts",
          "declaration": "T",
          "target": "name",
          "operation": "declared_type"
        },
        {
          "id": "Pattern",
          "file": "/case.ts",
          "declaration": "Pattern",
          "target": "name",
          "operation": "declared_type"
        },
