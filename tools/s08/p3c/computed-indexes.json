      },
      "roots": [
        "/computed-symbol-index.ts"
      ],
      "queries": [
        {
          "id": "A",
          "file": "/computed-symbol-index.ts",
          "declaration": "A",
          "target": "name",
          "operation": "declared_type"
        },
        {
          "id": "B",
          "file": "/computed-symbol-index.ts",
          "declaration": "B",
          "target": "name",
          "operation": "declared_type"
