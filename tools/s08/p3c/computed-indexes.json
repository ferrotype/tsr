{
  "version": 1,
  "scope": "P3 computed index aggregation and explicit-index precedence",
  "options": {
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "noLib": true
  },
  "programs": [
    {
      "id": "computed-string-index",
      "files": {
        "/computed-string-index.ts": "declare const key: string; interface I { [key](): number; stable(): string; } type A = I[string]; type B = keyof I;\n"
      },
      "roots": [
        "/computed-string-index.ts"
      ],
      "queries": [
        {
          "id": "A",
          "file": "/computed-string-index.ts",
          "declaration": "A",
          "target": "name",
          "operation": "declared_type"
        },
        {
          "id": "B",
          "file": "/computed-string-index.ts",
          "declaration": "B",
          "target": "name",
          "operation": "declared_type"
        }
      ]
    },
    {
